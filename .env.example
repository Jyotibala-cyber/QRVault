# QRVault Environment Configuration
# Copy this to .env and customize

# Flask secret key (CHANGE THIS in production)
SECRET_KEY=change-me-to-a-random-secret-key

# Database path
DATABASE_URL=instance/qrvault.db

# File storage path
STORAGE_PATH=storage/encrypted

# Maximum file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800

# Rate limiting
RATE_LIMIT_DEFAULT=200 per day
RATE_LIMIT_UPLOAD=30 per hour
RATE_LIMIT_DOWNLOAD=60 per hour
RATE_LIMIT_SHARE=100 per hour

# Cleanup interval in seconds (default: 1 hour)
CLEANUP_INTERVAL=3600

# Retention period after expiry in seconds (default: 24 hours)
RETENTION_PERIOD=86400
